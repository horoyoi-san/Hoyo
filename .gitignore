# =============================================================================
# AstralOS .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Rust & Cargo Artifacts
# -----------------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
*.lib
*.exp
*.ilk
persistent
**/persistent
upstream_robinsr/
**/upstream_robinsr/
*.exe
bin/*.exe
scratch.rs
scratch/
**/scratch/

# Python Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class


# -----------------------------------------------------------------------------
# 2. Node, Web, Vite & TypeScript
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
.cache/
**/.cache/
*.tsbuildinfo
.rollup.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# -----------------------------------------------------------------------------
# 3. Tauri Desktop Artifacts
# -----------------------------------------------------------------------------
src-tauri/target/
**/src-tauri/target/
src-tauri/WixTools/

# -----------------------------------------------------------------------------
# 4. Game Dumps, Metadata & Reverse Engineering Outputs
# -----------------------------------------------------------------------------
DUMP/
**/DUMP/
dumps/
**/dumps/
output/
**/output/
DummyDlls/
**/DummyDlls/
Resources/
**/Resources/
*.dump
*.pcap
*.pcapng

# Star Rail Game Binaries & Assets (Never commit raw client files)
GameAssembly.dll
StarRail.exe
UnityPlayer.dll
global-metadata.dat
*.asb
*.pck
*.blk
*.bytes

# Backups & Restorations
*.bak
*.backup
*.old
*.orig
*.json.bak

# Crash & Memory Dumps
*.dmp
*.mdmp
crash-dumps/

# -----------------------------------------------------------------------------
# 5. Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# -----------------------------------------------------------------------------
# 6. IDEs & Editors
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ, CLion, WebStorm, RustRover)
.idea/
*.iml
*.iws
*.ipr
/out/
!crates/robinsr_engine/proto/out/
!crates/robinsr_engine/proto/out/**

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# 7. Operating System Artifacts
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Linux
*~
.directory

# -----------------------------------------------------------------------------
# 8. Temporary & AI Workspace Files
# -----------------------------------------------------------------------------
tmp/
temp/
.temp/
.gemini/
**/.gemini/
.zcode/
**/.zcode/
.system_generated/
**/.system_generated/

